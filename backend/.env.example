# Gemini API — required. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash-lite (and gemini-2.0-flash) are no longer available to new
# API keys as of this project's build -- verified directly against the
# Gemini API; gemini-flash-lite-latest is the confirmed-working equivalent.
LLM_MODEL=gemini-flash-lite-latest

# Database — SQLite is the default local-demo profile (no setup required).
DATABASE_URL=sqlite:///./app.db

# To run against a real local PostgreSQL instead (Lane 2's Alembic baseline
# targets this): `docker compose -f docker-compose.dev.yml up -d --wait` from
# backend/, then uncomment the line below and run `& .\.venv\Scripts\python.exe
# -m alembic upgrade head` in PowerShell before starting the app. PostgreSQL
# startup intentionally fails when migrations are behind. See LANE2_SYNC.md
# and docs/contracts/data-authorization.md for what is/isn't covered yet.
# DATABASE_URL=postgresql://prism_app:prism_dev_local_only@localhost:55432/prism

# Whether startup seeds a synthetic demo player + all four curricula/dungeons.
# Unset defaults to true on SQLite (the zero-setup local demo needs this) and
# false on PostgreSQL (a migration-managed database is not assumed to be a
# throwaway demo). Set explicitly to override either way -- true/1/yes/on or
# false/0/no/off (case-insensitive). See db/database.py::should_seed_demo_data.
# SEED_DEMO_DATA=true

# OIDC identity verification (security/identity.py). `routes/learning_*.py`
# requires this to accept any request -- to verify real tokens locally:
# `docker compose -f docker-compose.dev.yml up -d --wait` from backend/, then
# uncomment both lines below. See backend/keycloak/README.md for the test
# users/passwords and how to mint a token by hand. This is a real, local,
# standards-compliant OIDC provider for testing -- not a government-approved
# production IdP (SIH26101_MASTER_CHECKLIST.md section 5.1 tracks that
# separately as BLOCKED-EXTERNAL).
# OIDC_ISSUER=http://localhost:8180/realms/prism
# OIDC_AUDIENCE=prism-backend-dev

# Local-dev-only bridge (routes/dev_auth.py) that lets the frontend's demo
# username login also obtain a real, fully-verified Keycloak bearer token,
# so /learning/* routes don't 401 while browsing the demo site locally. Not
# a production login path -- see that file's module docstring. Requires
# Keycloak running (see OIDC_ISSUER above) and is otherwise not mounted at
# all.
# ENABLE_DEV_LOGIN=true
# KEYCLOAK_DEV_TOKEN_URL=http://localhost:8180/realms/prism/protocol/openid-connect/token
# KEYCLOAK_DEV_CLIENT_ID=prism-backend-dev
# KEYCLOAK_DEV_CLIENT_SECRET=prism_dev_local_only_client_secret
# KEYCLOAK_DEV_USERNAME=demo-learner
# KEYCLOAK_DEV_PASSWORD=prism_dev_local_only

# Comma-separated list of origins allowed to call this API with credentials.
# :3001 is included because `next dev` silently falls back to it whenever
# :3000 is still occupied by a stale dev server from a previous run.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Where the /ai/* endpoints live. Defaults to this same server (self-contained
# mode). Point this at http://localhost:8001 to use the standalone AI service
# in services/ instead — see services/README.md.
AI_SERVICE_URL=http://localhost:8000

# Game config
DEFAULT_DOMAIN=Data Structures & Algorithms

# RL difficulty tuner (epsilon-greedy bandit)
RL_HARD_THRESHOLD=0.80
RL_MEDIUM_THRESHOLD=0.50
RL_EPSILON=0.1
