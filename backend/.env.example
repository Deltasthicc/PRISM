# ============================================================================
# TWO MODES
# ============================================================================
# This app has always had two real, working configurations, but the switches
# that select between them were five separate, independently-documented env
# vars scattered through this file with no single place naming the choice.
# They're grouped here as two copy-paste blocks instead. Every flag below is
# still read individually at process startup (a few are cached, see their own
# comments) -- there is no single "mode" variable the code branches on, this
# is a documentation grouping of switches that already existed.
#
# DEMO MODE (uncomment nothing below this block -- it is every default in
# this file as shipped): SQLite, no setup, `DISABLE_AUTH` unset so the
# frontend's username-only login cannot reach /learning/* at all unless you
# also uncomment it below -- most local runs want DISABLE_AUTH=true here.
# iGOT/NSSTA report CATALOGUE (no configured URL): recommendations link to
# the real public catalog pages, never a fabricated enrolment. This is the
# mode every test in this repo runs against and the one that is actually
# exercised and known-working.
#
# REAL MODE (uncomment the "real mode" line in each block below): local
# PostgreSQL + Alembic, real OIDC/Keycloak bearer-token verification, and (if
# you also set IGOT_API_BASE_URL/NSSTA_API_BASE_URL) a genuine HTTP health
# check against that URL before ever reporting LIVE. Be aware going in: no
# approved iGOT/NSSTA endpoint contract, credentials or sandbox exist for
# this project (PS-05/PS-17 in docs/SIH26101_PROBLEM_STATEMENT.md are tracked
# BLOCKED-EXTERNAL in SIH26101_MASTER_CHECKLIST.md section 4.3), so pointing
# IGOT_API_BASE_URL/NSSTA_API_BASE_URL at anything today will genuinely, and
# correctly, report CATALOGUE with an "unreachable" detail -- that is the
# honest result, not a bug to work around. The competency/scoring engine and
# the rest of the product work identically in both modes; only identity
# verification, persistence, and integration status genuinely differ.
# ============================================================================

# Gemini API — required. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash-lite (and gemini-2.0-flash) are no longer available to new
# API keys as of this project's build -- verified directly against the
# Gemini API; gemini-flash-lite-latest is the confirmed-working equivalent.
LLM_MODEL=gemini-flash-lite-latest

# Database — SQLite is the default local-demo profile (no setup required).
# To point this laptop at the team's shared database/backend instead of your
# own local one, see /deploy/README.md — set NEXT_PUBLIC_API_URL in
# frontend/.env.local rather than changing anything here.
DATABASE_URL=sqlite:///./app.db

# REAL MODE — run against a real local PostgreSQL instead (Lane 2's Alembic
# baseline targets this): `docker compose -f docker-compose.dev.yml up -d
# --wait` from backend/, then uncomment the line below and run
# `& .\.venv\Scripts\python.exe -m alembic upgrade head` in PowerShell before
# starting the app. PostgreSQL startup intentionally fails when migrations
# are behind. See docs/internal/LANE2_SYNC.md and docs/contracts/data-authorization.md
# for what is/isn't covered yet.
# DATABASE_URL=postgresql://prism_app:prism_dev_local_only@localhost:55432/prism

# Whether startup seeds a synthetic demo player + all four curricula/dungeons.
# Unset defaults to true on SQLite (the zero-setup local demo needs this) and
# false on PostgreSQL (a migration-managed database is not assumed to be a
# throwaway demo). Set explicitly to override either way -- true/1/yes/on or
# false/0/no/off (case-insensitive). See db/database.py::should_seed_demo_data.
# SEED_DEMO_DATA=true

# DEMO MODE — bypasses real bearer-token verification entirely (see
# routes/authorization.py's _DEMO_AUTH_DISABLED) -- a username alone is
# enough to act as that player, no Keycloak/OIDC round trip required. This
# grants every request full access; there is no real identity behind any
# call while this is set. Never set this for a deployment handling real
# user data. Uncomment this for demo mode -- per the note above, the
# frontend's only login flow cannot reach /learning/* without it or
# ENABLE_DEV_LOGIN below. Leave both unset for real mode's full OIDC/Keycloak
# verification -- the two settings below then apply as documented.
DISABLE_AUTH=true

# REAL MODE — OIDC identity verification (security/identity.py).
# `routes/learning_*.py` requires this to accept any request -- to verify
# real tokens locally: `docker compose -f docker-compose.dev.yml up -d --wait`
# from backend/, then uncomment both lines below (and comment out
# DISABLE_AUTH above -- the two are mutually exclusive in practice, since
# DISABLE_AUTH short-circuits before OIDC verification ever runs). See
# backend/keycloak/README.md for the test users/passwords and how to mint a
# token by hand. This is a real, local, standards-compliant OIDC provider for
# testing -- not a government-approved production IdP
# (SIH26101_MASTER_CHECKLIST.md section 5.1 tracks that separately as
# BLOCKED-EXTERNAL).
# OIDC_ISSUER=http://localhost:8180/realms/prism
# OIDC_AUDIENCE=prism-backend-dev

# REAL MODE — local-dev-only bridge (routes/dev_auth.py) that lets the
# frontend's demo username login also obtain a real, fully-verified Keycloak
# bearer token, so /learning/* routes don't 401 while browsing the demo site
# locally with real OIDC verification on. Not a production login path -- see
# that file's module docstring. Requires Keycloak running (see OIDC_ISSUER
# above) and is otherwise not mounted at all.
# ENABLE_DEV_LOGIN=true
# KEYCLOAK_DEV_TOKEN_URL=http://localhost:8180/realms/prism/protocol/openid-connect/token
# KEYCLOAK_DEV_CLIENT_ID=prism-backend-dev
# KEYCLOAK_DEV_CLIENT_SECRET=prism_dev_local_only_client_secret
# KEYCLOAK_DEV_USERNAME=demo-learner
# KEYCLOAK_DEV_PASSWORD=prism_dev_local_only

# REAL MODE — iGOT/NSSTA provider integration status
# (services/learning_catalog.py, integrations/provider.py). Unset (the demo
# default): every recommendation links to the real public catalog page,
# reported as CATALOGUE -- never a fabricated live sync. Set either URL to
# select a real `LiveHTTPProviderAdapter` that makes an actual short-timeout
# HTTP GET to `{url}/health` and reports LIVE only on a genuine 2xx response;
# any failure (no such host, connection refused, timeout, non-2xx) reports
# CATALOGUE with an honest "health check failed" detail, never LIVE. As the
# banner above says: no real iGOT/NSSTA endpoint exists for this project to
# point these at yet, so expect an honest CATALOGUE/unreachable result, not a
# working live sync.
# IGOT_API_BASE_URL=https://your-igot-sandbox.example.gov.in
# NSSTA_API_BASE_URL=https://your-nssta-sandbox.example.gov.in

# Comma-separated list of origins allowed to call this API with credentials.
# :3001 is included because `next dev` silently falls back to it whenever
# :3000 is still occupied by a stale dev server from a previous run.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Where the /ai/* endpoints live. Defaults to this same server (self-contained
# mode). Point this at http://localhost:8001 to use the standalone AI service
# in services/ instead — see services/README.md.
AI_SERVICE_URL=http://localhost:8000

# Game config
DEFAULT_DOMAIN=Data Structures & Algorithms

# RL difficulty tuner (epsilon-greedy bandit)
RL_HARD_THRESHOLD=0.80
RL_MEDIUM_THRESHOLD=0.50
RL_EPSILON=0.1

# DSA sandbox real code execution (routes/dsa_sandbox.py, services/judge_client.py).
# Learner code is never run on this API host (see
# SIH26101_MASTER_CHECKLIST.md section 4.4) -- it's always delegated to a
# real Judge0 instance. Defaults to the public, keyless Judge0 CE demo
# instance, which is fine for local development and a small demo audience
# but is a shared, rate-limited third party: point a real deployment at a
# self-hosted Judge0 instance instead (https://github.com/judge0/judge0).
# JUDGE0_BASE_URL=https://ce.judge0.com

# Only needed for a RapidAPI-hosted Judge0 instance (leave both unset for
# the public CE instance above, which needs neither).
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Voice pipeline (ai/voice/tts.py, ai/voice/stt.py) -- /voice's spoken replies.
# STT (faster-whisper) and the text answer work with zero config; TTS needs a
# local Piper voice model you supply yourself (not bundled -- a binary asset,
# gitignored under backend/models/piper/ same as any other machine-specific
# model file). Download a voice (e.g. en_US-lessac-medium) from
# https://huggingface.co/rhasspy/piper-voices and point both paths at it --
# without these, /voice still works but shows an honest "voice reply
# unavailable" note instead of speaking.
# PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
# PIPER_CONFIG_PATH=./models/piper/en_US-lessac-medium.onnx.json

# Optional: point faster-whisper at a fine-tuned local CTranslate2 model
# directory instead of the stock tiny.en download -- see
# backend/scripts/voice_finetuning/README.md to train your own domain-adapted
# model. Unset falls back to stock tiny.en, which still works.
# WHISPER_MODEL_PATH=./scripts/voice_finetuning/whisper-domain-finetuned-ct2
